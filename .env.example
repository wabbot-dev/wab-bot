# NAMES ONLY. Never put real values in this file or commit them.
# On Cloudflare there is no .env upload: secrets are set with `wrangler secret put <NAME>` (value on stdin; scripts/deploy-cloudflare.sh does it for you),
# plain settings can go in [vars] in wrangler.toml. For local `wrangler dev`, put FAKE values in a git-ignored `.dev.vars` file
# (scripts/smoke-local.sh generates one with random fake values and deletes it afterwards).

# SELF-PROVISIONING (no `wrangler secret put`): every NAME below except SETUP_NONCE can instead be sent once to POST /api/setup and is then kept
# in the Worker's Durable Object (docs/SELF-PROVISIONING.md). A real binding/var of the same name always wins over a stored value.
# SETUP_NONCE is a plain-text (NOT secret) var, >= 32 random chars, generated by `node scripts/cf-api-deploy.mjs init`; setup is disabled without it.
SETUP_NONCE=

# --- Meta (WhatsApp Cloud API) ---                                 (secrets)
# system-user token; the bridge is the ONLY holder (never give it to the agent)
WA_ACCESS_TOKEN=
# Meta app secret: verifies X-Hub-Signature-256 on every webhook POST
WA_APP_SECRET=
# >= 16 chars; you type the same value into Meta's webhook setup
WA_VERIFY_TOKEN=
# comma separated; empty = accept any number id on this app
WA_PHONE_NUMBER_IDS=
# comma separated approved template names; empty = templates disabled
WA_TEMPLATE_ALLOWLIST=
# your WhatsApp Business Account id (start_conversation by number; setup_check reads subscribed apps)
WA_WABA_ID=
# optional: your Meta app id (setup_check confirms this app is subscribed to the WABA)
WA_APP_ID=
# owner-only: numbers a bot-started message may reach before they wrote in (digits, comma separated; empty = none)
OUTREACH_ALLOWLIST=
GRAPH_VERSION=v25.0

# --- Safety defaults ---
# only the exact value "live" sends to non-allowlisted recipients
LAUNCH_MODE=test
# comma separated numbers allowed while LAUNCH_MODE is not live
TEST_RECIPIENTS=

# --- Auth for your own endpoints (each >= 16 chars)                (secrets, generated by scripts/deploy-cloudflare.sh)
# Authorization: Bearer for /mcp
MCP_TOKEN=
# Authorization: Bearer for /admin and /api/admin*
ADMIN_TOKEN=
# Bearer for /api/cron/retry-wakes (the Cron Trigger itself calls the handler directly, no HTTP)
CRON_SECRET=

# --- Agent wake ---
# must be https:// (http only for localhost); treat as a secret if it embeds a key
WAKE_URL=
# secret
WAKE_KEY=
WAKE_HEADER=
# bearer | header
WAKE_AUTH=bearer
WAKE_DEBOUNCE_MS=8000
# comma separated message types that wake the agent; empty = built-in default list
WAKE_TYPES=

# --- Tuning (all optional; defaults in lib/config.ts) ---
LEASE_MS=300000
MAX_MESSAGES=50
STALE_WAKE_MS=300000
RATE_CONV_MAX=5
RATE_CONV_WINDOW_MS=600000
RATE_GLOBAL_PER_HOUR=60
SEND_TIMEOUT_MS=15000

# --- Voice notes and images (Workers AI, docs/MEDIA.md). Needs the [ai] binding in wrangler.toml. ---
# on unless 0: transcribe inbound voice notes / describe inbound images (free plan: 10,000 Neurons/day; past it requests fail, nothing is billed)
MEDIA_TRANSCRIBE=
MEDIA_DESCRIBE=
# caps (longer / larger media gets a marker such as "[voice note, not transcribed: longer than 120 s]" and no model call)
MEDIA_MAX_AUDIO_SECONDS=120
MEDIA_MAX_AUDIO_BYTES=2000000
MEDIA_MAX_IMAGE_BYTES=3000000
MEDIA_TIMEOUT_MS=18000
# Workers AI model names (defaults: @cf/openai/whisper-large-v3-turbo, @cf/meta/llama-4-scout-17b-16e-instruct)
MEDIA_STT_MODEL=
MEDIA_VISION_MODEL=
# 1 = mount the owner-only POST /api/admin/media-selftest (test without a phone). Leave empty.
MEDIA_SELFTEST=

# --- Optional voice-note replies (docs/VOICE-REPLIES.md). Off by default; uses the same [ai] binding and free daily allowance. ---
# off (default) | mirror (recommended: answer a voice note with a voice note) | on (also when the agent asks with reply_as "voice")
VOICE_REPLIES=
# Workers AI text-to-speech model (default @cf/myshell-ai/melotts: en, fr, es, zh, ja, ko; no Arabic, Arabic replies go as text)
VOICE_TTS_MODEL=
# caps (over a cap, or on any failure, the plain text is sent)
VOICE_MAX_CHARS=400
VOICE_MAX_SECONDS=45
VOICE_TIMEOUT_MS=15000
# who speaks: workers-ai (default) | elevenlabs (Arabic, and languages Workers AI lacks, with your ElevenLabs voice; docs/VOICE-REPLIES.md)
VOICE_REPLY_PROVIDER=
# SECRET, stdin only (wrangler secret put ELEVENLABS_API_KEY < key-file). Scope: Text to Speech + Voices read. Never put the value here.
ELEVENLABS_API_KEY=
# the ElevenLabs voice id; model (default eleven_v4; eleven_v3 also works); cap in characters (longer replies go as text)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_MAX_CHARS=600
# 0 = do not prefix Arabic replies (eleven_v3/v4, Lebanese dialect on) with the [casual Beiruti Lebanese accent] direction
ELEVENLABS_ACCENT_TAG=
# wording hint for spoken Arabic replies: lebanese (default, Beiruti dialect in Arabic script) | none
ARABIC_REPLY_DIALECT=

# --- Meta setup route (OFF by default) ---
# 1 = mount /api/admin/meta-setup (needs ADMIN_TOKEN). Enable only while running setup, then remove it.
META_SETUP_ENABLED=
# 1 = that route answers from a built-in Meta stub; never calls graph.facebook.com
META_SETUP_DRY_RUN=

# --- Admin MCP (OFF unless the owner sets this; docs/mcp.md) ---
# Owner-held bearer secret (>= 32 random chars). Set it ONLY as a real Worker secret (`wrangler secret put ADMIN_MCP_TOKEN`); it is NOT self-provisioned and no
# tool can set it. Without it the /admin/mcp route answers 404.
ADMIN_MCP_TOKEN=

# --- Voice calling (OFF by default; docs/VOICE-CALLS.md). Cost note: about $0.08 per minute on the importer's own xAI account ---
# the importer's own xAI API key (secret). May be sent to POST /api/setup like the other secrets.
XAI_API_KEY=
# OWNER GATE. Bindings/vars only: no MCP tool, no setup route and no agent can change these.
# off (default) | test (only CALL_ALLOWED_CALLERS are answered) | live (needs the next two)
CALLING_MODE=off
# live only: the owner's attestation that Meta Business Verification is complete
CALLING_BV_DONE=
# live only: digits of the one business number the owner approved for calling
CALLING_GO_NUMBER=
# optional: which WhatsApp phone number id to arm (default: the first WA_PHONE_NUMBER_IDS entry)
CALLING_PHONE_NUMBER_ID=
# comma separated caller numbers (digits) the voice agent answers; required in test mode
CALL_ALLOWED_CALLERS=
# longest single call, in seconds (10 to 600, default 120)
CALL_MAX_SECONDS=120
# most call seconds per calendar month (UTC) before new calls are turned away (default 1200)
CALL_BUDGET_SECONDS=1200
CALL_VOICE=eve
# auto, or a language code such as en
CALL_LANGUAGE_HINT=auto
# off unless 1: the greeting says it is a virtual assistant (it never claims to be human either way)
CALL_DISCLOSE_AI=
# off unless 1: the greeting adds "this call may be recorded"
CALL_RECORDING_LINE=
# on unless 0: keep a text transcript of each call in your own Durable Object (never audio); expires after the retention days below
CALL_TRANSCRIPTS=
CALL_TRANSCRIPT_RETENTION_DAYS=30
CALL_BUSINESS_NAME=
CALL_GREETING=
CALL_INSTRUCTIONS=

# --- Local scripts only (scripts/meta-setup.mjs; read from the environment or a hidden prompt, never from argv) ---
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
# 6-digit registration PIN
META_REGISTER_PIN=
