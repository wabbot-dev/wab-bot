{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "lib/fake-doc.ts", "lib/meta-fake.ts"]
}
