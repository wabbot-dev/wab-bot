{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "lib/**/*.ts",
    "tests/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.d.mts"
  ],
  "exclude": [
    "node_modules",
    "tests/workers"
  ]
}
